---
import type { Package } from '../../data/packages';

const { pkg } = Astro.props as { pkg: Package };

const heroTitle = pkg.heroTitle ?? 'Classic Japan';
const heroEyebrow = pkg.heroEyebrow ?? 'CLASSIC JAPAN';
const bestFor = pkg.bestFor ?? 'First-time Japan travelers';
const atAGlance = pkg.atAGlance ?? {
  heading: 'Japan’s classics, thoughtfully brought together.',
  description:
    'This journey brings together Japan’s most iconic cities while leaving room to experience the culture, food and everyday atmosphere that make each destination different.',
  stats: [
    { label: 'Duration', value: '10 Days' },
    { label: 'Destinations', value: pkg.destinations },
    { label: 'Travel Style', value: 'Classic' },
    { label: 'Trip Type', value: 'Fixed Package' },
    { label: 'Starting From', value: `₹${pkg.price.toLocaleString('en-IN')}` }
  ]
};
const journeyHighlights = pkg.journeyHighlights ?? [];
const itineraryDays = pkg.itineraryDays ?? [];
const citySections = pkg.citySections ?? pkg.destinationPanels ?? [];
const food = pkg.foodSection ?? {
  heading: 'Japan without compromise.',
  description:
    'We understand that food is an important part of a Japan journey. Vegetarian and Jain-friendly dining arrangements can be incorporated into your travel plan according to your requirements.',
  points: ['Vegetarian-friendly options', 'Jain-friendly arrangements', 'Thoughtful restaurant planning'],
  image: '/images/food/japan-vegetarian-food.webp'
};
const includedItems = pkg.includedItems ?? [];
const excludedItems = pkg.excludedItems ?? [];
const inclusionsNote =
  pkg.inclusionsNote ??
  "What's included can vary depending on the final package configuration. Your detailed quotation will clearly outline all inclusions and exclusions.";
const optionalExperiences = pkg.optionalExperiences ?? [];
const importantInformation = pkg.importantInformation ?? [];
const faqItems = pkg.faqItems ?? [];
const finalCta = pkg.finalCta ?? {
  heading: 'Ready to experience Japan beyond the ordinary?',
  description:
    "Tell us your preferred dates, interests and travel style. We'll help you turn Classic Japan into a journey that feels right for you.",
  image: '/images/hero/japan-hero.webp'
};
---

<div class="classic-package">
  <section class="classic-hero">
    <img src={pkg.image} alt={heroTitle} class="classic-hero__image" />
    <div class="classic-hero__overlay"></div>
    <div class="container classic-hero__content">
      <p class="classic-hero__eyebrow">{heroEyebrow}</p>
      <h1>{heroTitle}</h1>
      <p class="classic-hero__meta">{pkg.duration} · {pkg.destinations}</p>
      <p class="classic-hero__summary">{pkg.heroDescription}</p>
      <div class="classic-hero__actions">
        <a class="classic-btn classic-btn--primary" href="/contact/">Get a Quote</a>
        <a class="classic-btn classic-btn--ghost" href="#classic-itinerary">View Itinerary ↓</a>
      </div>
    </div>
  </section>

  <section class="classic-strip">
    <div class="container">
      <div class="classic-strip__grid">
        {atAGlance.stats.map((item) => (
          <div class="classic-strip__item">
            <p>{item.label}</p>
            <h3>{item.value}</h3>
          </div>
        ))}
      </div>
      <header class="classic-section-head">
        <h2>{atAGlance.heading}</h2>
        <p>{atAGlance.description}</p>
      </header>
    </div>
  </section>

  <section class="classic-white">
    <div class="container">
      <header class="classic-section-head">
        <h2>{pkg.journeyHeading}</h2>
        <p>{pkg.journeyIntro}</p>
      </header>
      <div class="classic-highlights">
        {journeyHighlights.map((item) => (
          <article class="classic-highlight">
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="classic-itinerary" class="classic-cream">
    <div class="container">
      <header class="classic-section-head">
        <h2>Your 10-day Japan journey</h2>
        <p>Every day is designed to balance iconic sights with time to experience Japan at your own pace. The exact sequence can be adjusted depending on travel dates, availability and preferences.</p>
      </header>

      <div class="itinerary-grid">
        <aside class="itinerary-nav" aria-label="Itinerary day navigation">
          {itineraryDays.map((day, index) => (
            <button
              type="button"
              class={`itinerary-nav__item ${index === 0 ? 'is-active' : ''}`}
              data-day-nav={day.day}
            >
              Day {String(day.day).padStart(2, '0')}
            </button>
          ))}
        </aside>

        <div class="itinerary-list">
          {itineraryDays.map((day, index) => (
            <article class={`itinerary-card ${index === 0 ? 'is-active' : ''}`} data-day-item={day.day}>
              <button type="button" class="itinerary-card__toggle" aria-expanded={index === 0 ? 'true' : 'false'} data-day-toggle={day.day}>
                <span class="itinerary-card__day">DAY {String(day.day).padStart(2, '0')}</span>
                <span class="itinerary-card__title">{day.title}</span>
                <span class="itinerary-card__destination">{day.destination}</span>
              </button>
              <div class="itinerary-card__panel" hidden={index !== 0}>
                <p>{day.description}</p>
                {day.highlights?.length ? (
                  <ul>
                    {day.highlights.map((highlight) => <li>{highlight}</li>)}
                  </ul>
                ) : null}
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="classic-white">
    <div class="container">
      <header class="classic-section-head">
        <h2>Three cities. One unforgettable introduction to Japan.</h2>
        <p>The route is designed around contrast. Tokyo introduces you to Japan's modern side, Kyoto slows the pace with its historic streets and cultural heritage, and Osaka brings a more relaxed, energetic atmosphere shaped by its food and local character.</p>
      </header>
      <div class="city-stack">
        {citySections.map((city) => (
          <article class="city-panel">
            <img src={city.image} alt={city.name} />
            <div class="city-panel__content">
              <p class="city-panel__eyebrow">{city.name}</p>
              <h3>{city.name}</h3>
              <p>{city.description}</p>
              <ul>
                {city.highlights.map((point) => <li>{point}</li>)}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="classic-cream classic-transport">
    <div class="container">
      <header class="classic-section-head">
        <h2>Thoughtfully planned from arrival to departure.</h2>
      </header>
      <div class="transport-grid">
        <article>
          <h3>Accommodation</h3>
          <p>Comfortable stays selected around location, convenience and journey flow.</p>
        </article>
        <article>
          <h3>Transport</h3>
          <p>Planned intercity travel and local transportation according to the itinerary.</p>
        </article>
        <article>
          <h3>Airport Transfers</h3>
          <p>Airport transfer arrangements can be included according to the selected package.</p>
        </article>
        <article>
          <h3>Local Support</h3>
          <p>Guidance and assistance throughout the journey where applicable.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="classic-food">
    <div class="container classic-food__grid">
      <div class="classic-food__content">
        <h2>{food.heading}</h2>
        <p>{food.description}</p>
        <ul>
          {food.points.map((point) => <li>{point}</li>)}
        </ul>
      </div>
      <img src={food.image} alt="Japanese dining experience" />
    </div>
  </section>

  <section class="classic-white">
    <div class="container">
      <header class="classic-section-head">
        <h2>Everything planned around the journey.</h2>
      </header>
      <div class="included-grid">
        <article>
          <p class="label">Included</p>
          <ul>
            {includedItems.map((item) => <li>{item}</li>)}
          </ul>
        </article>
        <article>
          <p class="label">Not Included</p>
          <ul>
            {excludedItems.map((item) => <li>{item}</li>)}
          </ul>
        </article>
      </div>
      <p class="inclusions-note">{inclusionsNote}</p>
    </div>
  </section>

  <section class="classic-cream">
    <div class="container">
      <header class="classic-section-head">
        <h2>Like the route, but want to change the rhythm?</h2>
        <p>Classic Japan is a starting point, not a limitation. Add extra nights in Tokyo, slow down in Kyoto, extend your stay in Osaka or add another destination to the journey.</p>
      </header>
      <div class="optional-grid">
        {optionalExperiences.slice(0, 4).map((item) => (
          <article class="optional-card">
            <img src={item.image} alt={item.title} />
            <div class="optional-card__content">
              <p class="label">{item.label ?? 'Optional'}</p>
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </div>
          </article>
        ))}
      </div>
      <div class="optional-actions">
        <a class="text-link" href="/customise-your-trip/">Customize This Journey</a>
        <a class="text-link" href="/contact/">Get a Quote</a>
      </div>
    </div>
  </section>

  <section class="classic-white">
    <div class="container">
      <header class="classic-section-head">
        <h2>Frequently Asked Questions</h2>
      </header>
      <div class="faq-list">
        {faqItems.map((faq) => (
          <details class="faq-item">
            <summary>{faq.q}</summary>
            <div>
              <p>{faq.a}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="classic-final">
    <img src={finalCta.image} alt={finalCta.heading} />
    <div class="classic-final__overlay"></div>
    <div class="container classic-final__content">
      <p class="classic-final__eyebrow">READY TO EXPLORE JAPAN?</p>
      <h2>{finalCta.heading}</h2>
      <p>{finalCta.description}</p>
      <div class="classic-final__actions">
        <a class="classic-btn classic-btn--primary" href="/contact/">Get a Quote</a>
        <a class="classic-btn classic-btn--ghost" href="/customise-your-trip/">Customize This Journey →</a>
      </div>
    </div>
  </section>

  <script type="application/ld+json">
    {JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://journey-japan.org/' },
        { '@type': 'ListItem', position: 2, name: 'Packages', item: 'https://journey-japan.org/packages/' },
        { '@type': 'ListItem', position: 3, name: heroTitle, item: 'https://journey-japan.org/packages/classic-japan/' }
      ]
    })}
  </script>

  <script>
    (() => {
      const navButtons = Array.from(document.querySelectorAll('[data-day-nav]'));
      const cards = Array.from(document.querySelectorAll('[data-day-item]'));
      const toggles = Array.from(document.querySelectorAll('[data-day-toggle]'));

      function setActive(day, scrollIntoView) {
        navButtons.forEach((button) => {
          button.classList.toggle('is-active', button.dataset.dayNav === String(day));
        });
        cards.forEach((card) => {
          const active = card.dataset.dayItem === String(day);
          card.classList.toggle('is-active', active);
          const toggle = card.querySelector('[data-day-toggle]');
          const panel = card.querySelector('.itinerary-card__panel');
          if (toggle) toggle.setAttribute('aria-expanded', active ? 'true' : 'false');
          if (panel) panel.hidden = !active;
          if (active && scrollIntoView) card.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        });
      }

      navButtons.forEach((button) => {
        button.addEventListener('click', () => setActive(button.dataset.dayNav, true));
      });

      toggles.forEach((toggle) => {
        toggle.addEventListener('click', () => setActive(toggle.dataset.dayToggle, false));
      });
    })();
  </script>
</div>

<style>
  .classic-package {
    padding-top: 92px;
    overflow-x: clip;
    color: #242424;
  }

  .classic-hero,
  .classic-final {
    position: relative;
    min-height: clamp(620px, 76vh, 820px);
    overflow: hidden;
  }

  .classic-final {
    min-height: clamp(540px, 64vh, 640px);
  }

  .classic-hero__image,
  .classic-final img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .classic-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(0, 0, 0, 0.72) 0%, rgba(0, 0, 0, 0.52) 42%, rgba(0, 0, 0, 0.15) 100%);
  }

  .classic-final__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.28), rgba(0, 0, 0, 0.64));
  }

  .classic-hero__content,
  .classic-final__content {
    position: relative;
    z-index: 2;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-bottom: clamp(42px, 7vw, 84px);
    color: #fff;
  }

  .classic-hero__eyebrow,
  .classic-final__eyebrow,
  .label {
    margin: 0 0 14px;
    color: #F3DDE1;
    font-size: 12px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    font-weight: 600;
  }

  .classic-hero h1,
  .classic-final h2 {
    margin: 0;
    font-size: clamp(2.65rem, 5.6vw, 4.5rem);
    line-height: 1.03;
    letter-spacing: -0.05em;
    font-weight: 500;
    color: #FFFFFF;
    text-shadow: 0 2px 18px rgba(0,0,0,0.30);
  }

  .classic-hero__meta {
    margin: 14px 0 0;
    font-size: clamp(1rem, 1.7vw, 1.15rem);
    color: rgba(255,255,255,0.85);
  }

  .classic-hero__summary {
    max-width: 680px;
    margin: 16px 0 0;
    font-size: clamp(1rem, 1.55vw, 1.13rem);
    line-height: 1.65;
    color: rgba(255,255,255,0.86);
  }

  .classic-hero__best-for {
    margin: 12px 0 0;
    color: #F3DDE1;
    font-size: 14px;
    letter-spacing: 0.08em;
  }

  .classic-hero__actions,
  .classic-final__actions,
  .optional-actions {
    margin-top: 28px;
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .classic-btn {
    min-height: 52px;
    padding: 0 24px;
    border-radius: 12px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    font-weight: 600;
    transition: background 260ms ease, color 260ms ease, border-color 260ms ease, transform 260ms ease;
  }

  .classic-btn--primary {
    background: #FFFFFF;
    color: #171717;
  }

  .classic-btn--primary:hover,
  .classic-btn--primary:focus-visible {
    background: #B3262E;
    color: #FFFFFF;
    transform: translateY(-2px);
  }

  .classic-btn--ghost {
    background: transparent;
    color: #FFFFFF;
    border: 1px solid rgba(255,255,255,0.45);
  }

  .classic-btn--ghost:hover,
  .classic-btn--ghost:focus-visible {
    border-color: #FFFFFF;
    color: #FFFFFF;
  }

  .classic-strip,
  .classic-cream,
  .classic-white,
  .classic-food {
    padding: clamp(76px, 10vw, 140px) 0;
  }

  .classic-strip,
  .classic-cream {
    background: #F8F6F1;
  }

  .classic-white {
    background: #FFFFFF;
  }

  .classic-strip__grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    border-top: 1px solid rgba(23,23,23,0.12);
    border-bottom: 1px solid rgba(23,23,23,0.12);
  }

  .classic-strip__item {
    padding: 22px 10px;
    border-right: 1px solid rgba(23,23,23,0.08);
  }

  .classic-strip__item:last-child {
    border-right: 0;
  }

  .classic-strip__item p {
    margin: 0;
    font-size: 12px;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: #6F6F6F;
    font-weight: 600;
  }

  .classic-strip__item h3 {
    margin: 10px 0 0;
    font-size: 1rem;
    color: #171717;
    font-weight: 500;
  }

  .classic-section-head {
    max-width: 860px;
    margin-bottom: 34px;
  }

  .classic-section-head h2 {
    margin: 0;
    font-size: clamp(2.2rem, 4vw, 3.6rem);
    line-height: 1.06;
    letter-spacing: -0.05em;
    color: #171717;
    font-weight: 500;
  }

  .classic-section-head p {
    margin: 16px 0 0;
    color: #6F6F6F;
    font-size: 1.06rem;
    line-height: 1.7;
  }

  .classic-highlights,
  .transport-grid,
  .included-grid,
  .faq-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px 32px;
  }

  .classic-highlight,
  .transport-grid article,
  .included-grid article {
    border-top: 1px solid rgba(23,23,23,0.12);
    padding-top: 16px;
  }

  .classic-highlight h3,
  .transport-grid h3,
  .city-panel__content h3,
  .optional-card h3,
  .faq-item summary {
    margin: 0;
    font-size: clamp(1.3rem, 2vw, 1.58rem);
    line-height: 1.25;
    color: #171717;
    font-weight: 500;
  }

  .classic-highlight p,
  .transport-grid p,
  .city-panel__content p,
  .optional-card p,
  .included-grid p,
  .faq-item p,
  .classic-food__content p {
    margin: 10px 0 0;
    color: #6F6F6F;
    font-size: 15px;
    line-height: 1.7;
  }

  .itinerary-grid {
    display: grid;
    grid-template-columns: 260px minmax(0, 1fr);
    gap: 28px;
    align-items: start;
  }

  .itinerary-nav {
    position: sticky;
    top: 130px;
    display: grid;
    gap: 8px;
  }

  .itinerary-nav__item {
    border: 0;
    background: transparent;
    text-align: left;
    padding: 8px 0 8px 14px;
    border-left: 2px solid transparent;
    color: #6F6F6F;
    font-weight: 500;
    cursor: pointer;
  }

  .itinerary-nav__item.is-active {
    border-left-color: #B3262E;
    color: #B3262E;
  }

  .itinerary-list {
    display: grid;
    gap: 12px;
  }

  .itinerary-card {
    border: 1px solid rgba(23,23,23,0.1);
    border-radius: 16px;
    overflow: hidden;
    background: rgba(255,255,255,0.72);
  }

  .itinerary-card.is-active {
    border-color: rgba(179,38,46,0.35);
  }

  .itinerary-card__toggle {
    width: 100%;
    border: 0;
    background: transparent;
    text-align: left;
    padding: 18px 18px 16px;
    display: grid;
    gap: 4px;
    cursor: pointer;
  }

  .itinerary-card__day {
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #B3262E;
    font-weight: 600;
  }

  .itinerary-card__title {
    font-size: clamp(1.2rem, 1.8vw, 1.5rem);
    color: #171717;
    font-weight: 500;
    line-height: 1.25;
  }

  .itinerary-card__destination {
    color: #6F6F6F;
    font-size: 14px;
  }

  .itinerary-card__panel {
    padding: 0 18px 18px;
  }

  .itinerary-card__panel ul,
  .city-panel__content ul,
  .included-grid ul,
  .classic-food__content ul {
    margin: 12px 0 0;
    padding-left: 18px;
    color: #6F6F6F;
    line-height: 1.7;
  }

  .city-stack {
    display: grid;
    gap: 24px;
  }

  .city-panel {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    border: 1px solid rgba(23,23,23,0.1);
    border-radius: 20px;
    overflow: hidden;
    background: #FFFFFF;
  }

  .city-panel img,
  .optional-card img,
  .classic-food__grid img {
    width: 100%;
    height: 100%;
    min-height: 260px;
    object-fit: cover;
    display: block;
  }

  .city-panel__content {
    padding: clamp(20px, 4vw, 34px);
  }

  .city-panel__eyebrow {
    margin: 0 0 12px;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #B3262E;
    font-weight: 600;
  }

  .classic-transport article {
    padding-right: 18px;
  }

  .classic-food {
    background: #171717;
    color: #FFFFFF;
  }

  .classic-food__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.95fr);
    gap: 24px;
    align-items: center;
  }

  .classic-food__content h2,
  .classic-final h2 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 3.6rem);
    line-height: 1.08;
    letter-spacing: -0.05em;
    color: #FFFFFF;
    font-weight: 500;
  }

  .classic-food__content p,
  .classic-food__content ul,
  .classic-final p {
    color: rgba(255,255,255,0.78);
  }

  .classic-food__content ul {
    margin: 18px 0 0;
  }

  .included-grid article {
    padding-right: 18px;
  }

  .inclusions-note {
    margin: 18px 0 0;
    color: #6F6F6F;
    font-size: 14px;
    line-height: 1.6;
  }

  .optional-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
  }

  .optional-card {
    border: 1px solid rgba(23,23,23,0.1);
    border-radius: 16px;
    overflow: hidden;
    background: #FFFFFF;
  }

  .optional-card img {
    aspect-ratio: 4 / 3;
    min-height: 0;
  }

  .optional-card__content {
    padding: 16px;
  }

  .text-link {
    display: inline-flex;
    margin-top: 20px;
    color: #B3262E;
    text-decoration: none;
    font-weight: 600;
  }

  .text-link:hover,
  .text-link:focus-visible {
    color: #7F1D2D;
  }

  .faq-list {
    grid-template-columns: 1fr;
  }

  .faq-item {
    border-top: 1px solid rgba(23,23,23,0.12);
    padding-top: 14px;
  }

  .faq-item summary {
    cursor: pointer;
    list-style: none;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-item div {
    padding: 10px 0 0;
  }

  .classic-final__content {
    text-align: center;
