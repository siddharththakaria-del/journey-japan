---
import { type Package } from '../../data/packages';

const { pkg } = Astro.props as { pkg: Package };

const heroTitle = pkg.heroTitle ?? 'Tokyo & Kyoto Escape: Two Sides of Japan';
const heroEyebrow = pkg.heroEyebrow ?? 'TOKYO & KYOTO ESCAPE';
const bestFor = pkg.bestFor ?? 'First-time visitors & couples';
const atAGlance = pkg.atAGlance ?? {
  heading: 'Two iconic cities, one beautifully balanced escape.',
  description:
    "Seven days is enough to experience the very different personalities of Tokyo and Kyoto without trying to see all of Japan at once. This journey combines modern city life, historic neighbourhoods, Japanese culture and carefully selected experiences into a compact introduction to two of the country's most distinctive destinations.",
  stats: [
    { label: 'Duration', value: '7 DAYS' },
    { label: 'Route', value: 'Tokyo · Kyoto' },
    { label: 'Focus', value: 'City & Culture' },
    { label: 'Type', value: 'Fixed Package' },
    { label: 'Best For', value: 'First-time visitors & couples' },
    { label: 'From', value: `₹${pkg.price.toLocaleString('en-IN')}` }
  ]
};
const journeyHighlights = pkg.journeyHighlights ?? [];
const itineraryDays = pkg.itineraryDays ?? [];
const citySections = pkg.citySections ?? [];
const food = pkg.foodSection ?? {
  heading: 'Good travel should work around you.',
  description:
    'Food is part of the journey, and dietary preferences should never feel like an afterthought. Vegetarian and Jain-friendly dining arrangements can be incorporated into the trip through thoughtful planning and restaurant selection.',
  points: ['Vegetarian-friendly', 'Jain-friendly', 'Japanese cuisine'],
  image: '/images/packages/tokyo-kyoto-escape/tokyo-kyoto-escape-dining.webp'
};
const includedItems = pkg.includedItems ?? [];
const excludedItems = pkg.excludedItems ?? [];
const inclusionsNote = pkg.inclusionsNote ?? 'Final inclusions and exclusions will be clearly outlined in your quotation.';
const optionalExperiences = pkg.optionalExperiences ?? [];
const faqItems = pkg.faqItems ?? [];
const finalCta = pkg.finalCta ?? {
  heading: 'Ready to discover Tokyo and Kyoto?',
  description:
    "Tell us when you want to travel and what you'd like to experience. We'll help you shape the right Japan journey."
};
---

<div class="escape-package">
  <section class="escape-hero">
    <img src={pkg.image} alt={heroTitle} class="escape-hero__image" />
    <div class="escape-hero__overlay"></div>
    <div class="container escape-hero__content">
      <p class="escape-hero__eyebrow">{heroEyebrow}</p>
      <h1>{heroTitle}</h1>
      <p class="escape-hero__meta">{pkg.duration} · {pkg.destinations} · Fixed Package</p>
      <p class="escape-hero__summary">{pkg.heroDescription}</p>
      <div class="escape-hero__actions">
        <a class="escape-btn escape-btn--primary" href="/contact/">Get a Quote</a>
        <a class="escape-btn escape-btn--ghost" href="#route">See the Journey ↓</a>
      </div>
    </div>
  </section>

  <section class="escape-glance">
    <div class="container">
      <div class="escape-glance__grid">
        {atAGlance.stats.map((item) => (
          <div class="escape-glance__item">
            <p>{item.label}</p>
            <h3>{item.value}</h3>
          </div>
        ))}
      </div>
      <header class="escape-section-head">
        <h2>{atAGlance.heading}</h2>
        <p>{atAGlance.description}</p>
      </header>
    </div>
  </section>

  <section class="escape-white">
    <div class="container">
      <header class="escape-section-head">
        <h2>{pkg.journeyHeading}</h2>
        <p>{pkg.journeyIntro}</p>
      </header>
      <div class="escape-highlights">
        {journeyHighlights.map((item) => (
          <article class="escape-highlight">
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="route" class="escape-cream">
    <div class="container">
      <header class="escape-section-head">
        <h2>Seven days, carefully paced.</h2>
      </header>

      <div class="route-layout">
        <aside class="route-nav" aria-label="Route days">
          {itineraryDays.map((day, index) => (
            <button
              type="button"
              class={`route-nav__item ${index === 0 ? 'is-active' : ''}`}
              data-day-nav={day.day}
            >
              Day {String(day.day).padStart(2, '0')}
            </button>
          ))}
        </aside>

        <div class="route-panel">
          <div class="route-panel__image">
            <img src="/journey-japan/images/packages/tokyo-kyoto-escape/tokyo-kyoto-escape-journey.webp" alt="Tokyo to Kyoto journey" />
          </div>
          <div class="route-list">
            {itineraryDays.map((day, index) => (
              <details class="route-day" open={index === 0} data-day-item={day.day}>
                <summary>
                  <span class="route-day__index">DAY {String(day.day).padStart(2, '0')}</span>
                  <span class="route-day__title">{day.title}</span>
                  <span class="route-day__dest">{day.destination}</span>
                </summary>
                <div class="route-day__body">
                  <p>{day.description}</p>
                  {day.highlights?.length ? (
                    <ul>
                      {day.highlights.map((highlight) => <li>{highlight}</li>)}
                    </ul>
                  ) : null}
                </div>
              </details>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="escape-white">
    <div class="container">
      <div class="city-stack">
        {citySections.map((city) => (
          <article class="city-panel">
            <img src={city.image} alt={city.name} />
            <div class="city-panel__content">
              <p class="city-panel__eyebrow">{city.name}</p>
              <h3>{city.name === 'Tokyo' ? 'Tokyo: Japan in motion.' : 'Kyoto: Japan at a slower pace.'}</h3>
              <p>{city.description}</p>
              <ul>
                {city.highlights.map((point) => <li>{point}</li>)}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="escape-journey">
    <div class="container">
      <div class="journey-rail">
        <span>Tokyo</span>
        <span>→</span>
        <span>Shinkansen</span>
        <span>→</span>
        <span>Kyoto</span>
      </div>
      <header class="escape-section-head">
        <h2>Then, the landscape changes.</h2>
        <p>Leave Tokyo behind and watch the landscape shift as you travel towards Kyoto. The journey itself becomes part of the experience — moving from one of Japan's busiest cities toward a destination defined by history, tradition and a slower pace.</p>
      </header>
    </div>
  </section>

  <section class="escape-white">
    <div class="container">
      <header class="escape-section-head">
        <h2>Kyoto: Japan at a slower pace.</h2>
        <p>Kyoto invites you to slow down. Walk through traditional lanes, discover historic architecture, experience Japanese gardens and take time to appreciate the details that can easily be missed when travelling too quickly.</p>
      </header>
      <article class="kyoto-feature">
        <div class="kyoto-feature__label">
          <p class="eyebrow">KYOTO</p>
          <h3>Traditional Kyoto · Culture & Craft · Slow Moments</h3>
          <p>Historic streets, traditional architecture and a calmer rhythm make Kyoto the ideal counterpoint to Tokyo.</p>
        </div>
        <div class="kyoto-feature__note">
          <p>Historic streets, traditional architecture and a calmer rhythm make Kyoto the ideal counterpoint to Tokyo.</p>
        </div>
      </article>
    </div>
  </section>

  <section class="escape-food">
    <div class="container escape-food__grid">
      <div class="escape-food__content">
        <h2>{food.heading}</h2>
        <p>{food.description}</p>
        <ul>
          {food.points.map((point) => <li>{point}</li>)}
        </ul>
      </div>
      <img src={food.image} alt="Japanese dining" />
    </div>
  </section>

  <section class="escape-white">
    <div class="container">
      <header class="escape-section-head">
        <h2>The important details, taken care of.</h2>
      </header>
      <div class="included-grid">
        <article>
          <p class="eyebrow">Included</p>
          <ul>
            {includedItems.map((item) => <li>{item}</li>)}
          </ul>
        </article>
        <article>
          <p class="eyebrow">Not Included</p>
          <ul>
            {excludedItems.map((item) => <li>{item}</li>)}
          </ul>
        </article>
      </div>
      <p class="inclusions-note">{inclusionsNote}</p>
    </div>
  </section>

  <section class="escape-cream">
    <div class="container">
      <header class="escape-section-head">
        <h2>Seven days is the starting point, not the limit.</h2>
        <p>Want another night in Tokyo? Prefer more time in Kyoto? Want to add Hakone, Osaka or Mount Fuji? Tell us how you'd like to travel and we can adapt the journey around you.</p>
      </header>
      <div class="optional-grid">
        {optionalExperiences.map((item) => (
          <article class="optional-card">
            {item.image ? <img src={item.image} alt={item.title} /> : <div class="optional-card__placeholder"></div>}
            <div class="optional-card__content">
              <p class="eyebrow">{item.label ?? 'Optional'}</p>
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </div>
          </article>
        ))}
      </div>
      <div class="optional-actions">
        <a class="text-link" href="/customise-your-trip/">Customize This Journey</a>
        <a class="text-link" href="/contact/">Get a Quote</a>
      </div>
    </div>
  </section>

  <section class="escape-white">
    <div class="container">
      <header class="escape-section-head">
        <h2>Frequently Asked Questions</h2>
      </header>
      <div class="faq-list">
        {faqItems.map((faq) => (
          <details class="faq-item">
            <summary>{faq.q}</summary>
            <div><p>{faq.a}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="escape-final">
    <div class="escape-final__overlay"></div>
    <div class="container escape-final__content">
      <p class="eyebrow">READY TO EXPLORE?</p>
      <h2>{finalCta.heading}</h2>
      <p>{finalCta.description}</p>
      <div class="escape-final__actions">
        <a class="escape-btn escape-btn--primary" href="/contact/">Get a Quote</a>
        <a class="escape-btn escape-btn--ghost" href="/customise-your-trip/">Customize This Journey →</a>
      </div>
    </div>
  </section>

  <script>
    (() => {
      const buttons = Array.from(document.querySelectorAll('[data-day-nav]'));
      const cards = Array.from(document.querySelectorAll('[data-day-item]'));
      buttons.forEach((button) => {
        button.addEventListener('click', () => {
          const target = button.dataset.dayNav;
          buttons.forEach((item) => item.classList.toggle('is-active', item === button));
          cards.forEach((card) => {
            const active = card.dataset.dayItem === target;
            card.open = active;
          });
        });
      });
    })();
  </script>
</div>

<style>
  .escape-package {
    padding-top: 92px;
    overflow-x: clip;
    color: #242424;
  }

  .escape-hero,
  .escape-final {
    position: relative;
    min-height: clamp(560px, 74vh, 820px);
    overflow: hidden;
  }

  .escape-final {
    min-height: clamp(500px, 58vh, 620px);
    background: #171717;
  }

  .escape-hero__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .escape-hero__overlay,
  .escape-final__overlay {
    position: absolute;
    inset: 0;
  }

  .escape-hero__overlay {
    background: linear-gradient(90deg, rgba(0,0,0,0.78) 0%, rgba(0,0,0,0.55) 42%, rgba(0,0,0,0.12) 100%);
  }

  .escape-final__overlay {
    background: linear-gradient(180deg, rgba(0,0,0,0.30), rgba(0,0,0,0.65));
  }

  .escape-hero__content,
  .escape-final__content {
    position: relative;
    z-index: 2;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-bottom: clamp(40px, 7vw, 84px);
    color: #FFFFFF;
  }

  .escape-hero__eyebrow,
  .eyebrow {
    margin: 0 0 14px;
    color: #F3DDE1;
    font-size: 12px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    font-weight: 600;
  }

  .escape-hero h1,
  .escape-final h2 {
    margin: 0;
    font-size: clamp(2.65rem, 5.8vw, 4.5rem);
    line-height: 1.03;
    letter-spacing: -0.05em;
    font-weight: 500;
    color: #FFFFFF;
    text-shadow: 0 2px 18px rgba(0,0,0,0.35);
  }

  .escape-hero__meta {
    margin: 14px 0 0;
    font-size: clamp(1rem, 1.7vw, 1.15rem);
    color: rgba(255,255,255,0.85);
  }

  .escape-hero__summary {
    max-width: 680px;
    margin: 16px 0 0;
    font-size: clamp(1rem, 1.55vw, 1.13rem);
    line-height: 1.65;
    color: rgba(255,255,255,0.86);
  }

  .escape-hero__actions,
  .escape-final__actions,
  .optional-actions {
    margin-top: 28px;
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .escape-btn {
    min-height: 52px;
    padding: 0 24px;
    border-radius: 12px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    font-weight: 600;
    transition: background 260ms ease, color 260ms ease, border-color 260ms ease, transform 260ms ease;
  }

  .escape-btn--primary {
    background: #FFFFFF;
    color: #171717;
  }

  .escape-btn--primary:hover,
  .escape-btn--primary:focus-visible {
    background: #B3262E;
    color: #FFFFFF;
    transform: translateY(-2px);
  }

  .escape-btn--ghost {
    background: transparent;
    color: #FFFFFF;
    border: 1px solid rgba(255,255,255,0.45);
  }

  .escape-btn--ghost:hover,
  .escape-btn--ghost:focus-visible {
    border-color: #FFFFFF;
  }

  .escape-glance,
  .escape-cream,
  .escape-white,
  .escape-journey {
    padding: clamp(76px, 10vw, 140px) 0;
  }

  .escape-glance,
  .escape-cream,
  .escape-journey {
    background: #F8F6F1;
  }

  .escape-white {
    background: #FFFFFF;
  }

  .escape-glance__grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    border-top: 1px solid rgba(23,23,23,0.12);
    border-bottom: 1px solid rgba(23,23,23,0.12);
  }

  .escape-glance__item {
    padding: 22px 10px;
    border-right: 1px solid rgba(23,23,23,0.08);
  }

  .escape-glance__item:last-child {
    border-right: 0;
  }

  .escape-glance__item p {
    margin: 0;
    font-size: 12px;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: #6F6F6F;
    font-weight: 600;
  }

  .escape-glance__item h3 {
    margin: 10px 0 0;
    font-size: 1rem;
    color: #171717;
    font-weight: 500;
  }

  .escape-section-head {
    max-width: 860px;
    margin: 36px 0 0;
  }

  .escape-section-head h2 {
    margin: 0;
    font-size: clamp(2.2rem, 4vw, 3.6rem);
    line-height: 1.06;
    letter-spacing: -0.05em;
    color: #171717;
    font-weight: 500;
  }

  .escape-section-head p {
    margin: 16px 0 0;
    color: #6F6F6F;
    font-size: 1.06rem;
    line-height: 1.7;
  }

  .escape-highlights,
  .included-grid,
  .faq-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px 32px;
  }

  .escape-highlight,
  .included-grid article {
    border-top: 1px solid rgba(23,23,23,0.12);
    padding-top: 16px;
  }

  .escape-highlight h3,
  .city-panel__content h3,
  .kyoto-feature h3,
  .optional-card h3,
  .faq-item summary {
    margin: 0;
    font-size: clamp(1.3rem, 2vw, 1.58rem);
    line-height: 1.25;
    color: #171717;
    font-weight: 500;
  }

  .escape-highlight p,
  .city-panel__content p,
  .kyoto-feature p,
  .optional-card p,
  .included-grid p,
  .faq-item p,
  .escape-food__content p {
    margin: 10px 0 0;
    color: #6F6F6F;
    font-size: 15px;
    line-height: 1.7;
  }

  .route-layout {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);
    gap: 28px;
    align-items: start;
  }

  .route-nav {
    position: sticky;
    top: 130px;
    display: grid;
    gap: 8px;
  }

  .route-nav__item {
    border: 0;
    background: transparent;
    text-align: left;
    padding: 8px 0 8px 14px;
    border-left: 2px solid transparent;
    color: #6F6F6F;
    font-weight: 500;
    cursor: pointer;
  }

  .route-nav__item.is-active {
    border-left-color: #B3262E;
    color: #B3262E;
  }

  .route-panel {
    display: grid;
    gap: 24px;
  }

  .route-panel__image img,
  .city-panel img,
  .optional-card img,
  .escape-food__grid img {
    width: 100%;
    height: 100%;
    min-height: 260px;
    object-fit: cover;
    display: block;
    border-radius: 20px;
  }

  .route-day {
    border: 1px solid rgba(23,23,23,0.1);
    border-radius: 16px;
    overflow: hidden;
    background: rgba(255,255,255,0.7);
  }

  .route-day summary {
    list-style: none;
    cursor: pointer;
    padding: 18px;
    display: grid;
    gap: 4px;
  }

  .route-day summary::-webkit-details-marker {
    display: none;
  }

  .route-day__index {
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #B3262E;
    font-weight: 600;
  }

  .route-day__title {
    font-size: clamp(1.2rem, 1.8vw, 1.5rem);
    color: #171717;
    font-weight: 500;
    line-height: 1.25;
  }

  .route-day__dest {
    color: #6F6F6F;
    font-size: 14px;
  }

  .route-day__body {
    padding: 0 18px 18px;
  }

  .route-day__body ul,
  .city-panel__content ul,
  .included-grid ul,
  .escape-food__content ul {
    margin: 12px 0 0;
    padding-left: 18px;
    color: #6F6F6F;
    line-height: 1.7;
  }

  .city-stack {
    display: grid;
    gap: 24px;
  }

  .city-panel {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    border: 1px solid rgba(23,23,23,0.1);
    border-radius: 20px;
    overflow: hidden;
    background: #FFFFFF;
  }

  .city-panel__content {
    padding: clamp(20px, 4vw, 34px);
  }

  .city-panel__eyebrow {
    margin: 0 0 12px;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #B3262E;
    font-weight: 600;
  }

  .escape-journey .journey-rail {
    display: inline-flex;
    gap: 12px;
    flex-wrap: wrap;
    align-items: center;
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #6F6F6F;
  }

  .escape-food {
    background: #171717;
    color: #FFFFFF;
    padding: clamp(80px, 10vw, 140px) 0;
  }

  .escape-food__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.95fr);
    gap: 24px;
    align-items: center;
  }

  .escape-food__content h2,
  .escape-final h2 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 3.6rem);
    line-height: 1.08;
    letter-spacing: -0.05em;
    color: #FFFFFF;
    font-weight: 500;
  }

  .escape-food__content p,
  .escape-final p {
    color: rgba(255,255,255,0.78);
  }

  .escape-food__content ul {
    color: rgba(255,255,255,0.88);
  }

  .inclusions-note {
    margin: 18px 0 0;
    color: #6F6F6F;
    font-size: 14px;
    line-height: 1.6;
  }

  .optional-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }

  .optional-card {
    border: 1px solid rgba(23,23,23,0.1);
    border-radius: 16px;
    overflow: hidden;
    background: #FFFFFF;
  }

  .optional-card img {
    aspect-ratio: 4 / 3;
    min-height: 0;
    border-radius: 0;
  }

  .optional-card__placeholder {
    aspect-ratio: 4 / 3;
    background: linear-gradient(135deg, rgba(179,38,46,0.12), rgba(184,154,90,0.12));
  }

  .optional-card__content {
    padding: 16px;
  }

  .text-link {
    display: inline-flex;
    margin-top: 20px;
    color: #B3262E;
    text-decoration: none;
    font-weight: 600;
  }

  .text-link:hover,
  .text-link:focus-visible {
    color: #7F1D2D;
  }

  .kyoto-feature {
    margin-top: 28px;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: 24px;
    align-items: stretch;
    border: 1px solid rgba(23,23,23,0.1);
    border-radius: 20px;
    overflow: hidden;
    background: linear-gradient(135deg, rgba(179,38,46,0.05), rgba(248,246,241,0.75));
    padding: 0;
  }

  .kyoto-feature__label,
  .kyoto-feature__note {
    padding: clamp(20px, 4vw, 34px);
  }

  .kyoto-feature__note {
    display: flex;
    align-items: flex-end;
    border-left: 1px solid rgba(23,23,23,0.08);
  }

  .escape-final__content {
    text-align: center;
    align-items: center;
  }

  .escape-final__content p {
    max-width: 760px;
    margin: 16px auto 0;
    line-height: 1.7;
    font-size: 16px;
  }

  .faq-item {
    border-top: 1px solid rgba(23,23,23,0.12);
    padding-top: 14px;
  }

  .faq-item summary {
    cursor: pointer;
    list-style: none;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-item div {
    padding: 10px 0 0;
  }

  @media (max-width: 1199px) {
    .optional-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 899px) {
    .escape-package {
