---
const exploreLinks = [
  { label: 'Japan Packages', href: '/journey-japan/packages/' },
  { label: 'Customise Your Trip', href: '/journey-japan/customise-your-trip/' },
  { label: 'Why Japan', href: '/journey-japan/why-japan/' },
  { label: 'Travel Guide', href: '/journey-japan/travel-guide/' }
];

const planLinks = [
  { label: 'About Journey Japan', href: '/journey-japan/about/' },
  { label: 'Contact', href: '/journey-japan/contact/' },
  { label: 'Privacy Policy', href: '/journey-japan/privacy-policy/' },
  { label: 'Terms & Conditions', href: '/journey-japan/terms-and-conditions/' }
];
---

<footer class="site-footer" role="contentinfo">
  <div class="jj-container footer-inner">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="footer-logo" href="/journey-japan/" aria-label="Journey Japan home">
          <img src="/journey-japan/images/logo/jj_logo.webp" alt="Journey Japan" />
        </a>
        <p class="brand-line">Authentic Japan, thoughtfully curated.</p>
        <p class="brand-copy">From carefully planned itineraries to completely personalized journeys, we help travelers experience Japan with confidence.</p>
      </div>

      <div class="footer-column" aria-label="Explore Journey Japan navigation">
        <h3>Explore</h3>
        <nav aria-label="Explore">
          <ul>
            {exploreLinks.map((link) => (
              <li><a href={link.href}>{link.label}</a></li>
            ))}
          </ul>
        </nav>
      </div>

      <div class="footer-column" aria-label="Journey Japan links">
        <h3>Journey Japan</h3>
        <nav aria-label="Journey Japan">
          <ul>
            {planLinks.map((link) => (
              <li><a href={link.href}>{link.label}</a></li>
            ))}
          </ul>
        </nav>
      </div>

      <div class="footer-contact">
        <div class="contact-row">
          <span class="contact-kicker">Let's plan Japan.</span>
          <p>Start with the contact page if you want to discuss your Japan journey.</p>
        </div>

        <a class="footer-cta" href="/journey-japan/contact/">Contact Us</a>
      </div>
    </div>

    <div class="footer-divider">
      <div class="footer-legal">
        <span>Ãƒâ€šÃ‚Â© 2026 Journey Japan. All rights reserved.</span>
      </div>
    </div>
  </div>
</footer>

<style>
.site-footer{background:var(--jj-charcoal);color:var(--jj-cream);padding:96px 0 30px;border-top:1px solid rgba(248,246,241,0.06)}
.footer-inner{width:min(1280px, calc(100% - 48px));margin:0 auto}
.footer-grid{display:grid;grid-template-columns:1.8fr 1fr 1fr 1.2fr;gap:clamp(24px,4vw,48px);align-items:start}
.footer-brand{max-width:350px}
.footer-logo{display:inline-flex;align-items:center}
.footer-logo img{display:block;height:44px;width:auto}
.brand-line{margin-top:18px;color:var(--jj-cream);font-size:clamp(20px,1.6vw,24px);font-weight:500;line-height:1.3}
.brand-copy{margin-top:14px;color:rgba(248,246,241,0.62);font-size:15px;line-height:1.6}
.footer-column h3,.contact-kicker{margin:0;color:var(--jj-sakura);font-size:13px;font-weight:600;letter-spacing:0.12em;text-transform:uppercase}
.footer-column nav ul{list-style:none;margin:18px 0 0;padding:0;display:grid;gap:14px}
.footer-column a{color:rgba(248,246,241,0.68);text-decoration:none;transition:color 250ms ease,transform 250ms ease;font-size:14px}
.footer-column a:hover{color:var(--jj-white);transform:translateX(4px)}
.footer-contact{display:grid;gap:20px}
.contact-row p{margin-top:14px;color:rgba(248,246,241,0.62);font-size:15px;line-height:1.6}
.footer-cta{display:inline-flex;align-items:center;justify-content:center;width:fit-content;height:50px;padding:0 22px;background:var(--jj-white);color:var(--jj-charcoal);border-radius:12px;font-size:15px;font-weight:600;text-decoration:none;transition:background 300ms ease,color 300ms ease,transform 300ms ease}
.footer-cta:hover{background:var(--jj-red);color:var(--jj-white);transform:translateY(-2px)}
.footer-divider{border-top:1px solid rgba(248,246,241,0.12);margin-top:28px;padding-top:20px}
.footer-legal{display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap;color:rgba(248,246,241,0.45);font-size:12px}

@media (max-width: 980px){
  .footer-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
}

@media (max-width: 720px){
  .site-footer{padding:70px 0 24px}
  .footer-inner{width:min(100% - 32px, 1280px)}
  .footer-grid{grid-template-columns:1fr;gap:34px}
  .footer-divider{margin-top:20px;padding-top:18px}
}
</style>

