---
const props = Astro.props as { phone?: string; label?: string };
const phone = props.phone ?? '+911234567890';
const label = props.label ?? 'Chat on WhatsApp';
const url = `https://wa.me/${phone.replace(/\D/g,'')}?text=${encodeURIComponent('Hello Journey Japan, I would like to enquire about a trip.')}`;
---
<a class="whatsapp-button" href={url} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp">
  {label}
</a>

<style>
.whatsapp-button{display:inline-flex;align-items:center;gap:10px;padding:10px 14px;border-radius:10px;background:#25D366;color:#fff}
</style>
