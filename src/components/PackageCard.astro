---
import type { Package } from '../data/packages';
const pkg = Astro.props as Package;
---
<article class="card" style="display:flex;flex-direction:column">
  <a href={`/journey-japan/packages/${pkg.slug}/`} style="display:block;overflow:hidden">
    <img src={pkg.image} alt={pkg.title} style="width:100%;height:220px;object-fit:cover" />
  </a>
  <div class="card__content">
    <h3 class="h3">{pkg.title}</h3>
    <div class="small" style="color:var(--muted);margin-top:6px">{pkg.destination} • {pkg.duration} • {pkg.travelType}</div>
    <p style="margin-top:8px" class="lead">{pkg.short}</p>
    <div style="display:flex;justify-content:space-between;align-items:center;margin-top:12px">
      <div><strong>From</strong> <div>INR {pkg.priceFromINR.toLocaleString('en-IN')}</div></div>
      <a class="button" href={`/journey-japan/packages/${pkg.slug}/`} aria-label={`Explore ${pkg.title}`}>Explore</a>
    </div>
  </div>
</article>

<style>
.card{border-radius:14px}
.card__content .h3{font-size:18px;margin:0}
</style>
