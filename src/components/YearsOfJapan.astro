const expertisePoints = [
  'Itinerary design shaped by season, geography and pacing.',
  'Local relationships that help unlock more considered experiences.',
  'Transport, dining and accommodation planned with real-world detail.',
  'Authentic journeys built around the Japan travelers actually want to feel.'
];
---

<section class="jj-section years-of-japan" aria-labelledby="years-of-japan-heading">
  <div class="jj-container years-layout">
    <div class="years-header">
      <div class="eyebrow">OUR EXPERIENCE</div>
      <h2 id="years-of-japan-heading">Three decades of knowing Japan.</h2>
      <p>More than three decades of experience shape how we design trips — from timing and routing to dining, accommodation and the small choices that make a journey feel effortless.</p>
      <div class="years-figure" aria-label="30 years of Japan experience">
        <div class="years-number">30+</div>
        <div class="years-label">YEARS OF JAPAN</div>
      </div>
    </div>

    <div class="experience-panel reveal">
      <div class="story-image">
        <img src="/journey-japan/images/about/japan-expertise.webp" alt="Japan expertise and local knowledge" />
      </div>

      <div class="expertise-list" aria-label="How experience shapes journey design">
        {expertisePoints.map((point, index) => (
          <div class="expertise-item">
            <div class="expertise-index">0{index + 1}</div>
            <p>{point}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
.years-of-japan{position:relative;background:var(--jj-cream);padding:clamp(120px,14vw,200px) 0}
.years-layout{display:grid;grid-template-columns:1.05fr 1fr;gap:60px;align-items:start}
.years-header{max-width:620px}
.eyebrow{font-size:13px;font-weight:600;letter-spacing:0.15em;color:var(--jj-red);margin-bottom:14px}
.years-header h2{margin:0;font-size:clamp(40px,4.2vw,70px);line-height:1.02;color:var(--jj-charcoal);font-weight:500}
.years-header p{margin-top:18px;font-size:17px;line-height:1.7;color:var(--jj-muted)}

.years-figure{margin-top:36px}
.years-number{font-size:clamp(100px,12vw,220px);line-height:0.8;color:var(--jj-red);font-weight:500;letter-spacing:-0.06em}
.years-label{font-size:12px;letter-spacing:0.14em;color:var(--jj-muted);margin-top:8px}

.experience-panel{display:grid;gap:22px}
.story-image{border-radius:22px;overflow:hidden;background:#e9e3d9;opacity:0;transform:translateY(18px);transition:opacity 700ms ease, transform 700ms ease}
.story-image.visible{opacity:1;transform:translateY(0)}
.experience-panel.visible .story-image{opacity:1;transform:translateY(0)}
.story-image img{display:block;width:100%;height:100%;min-height:320px;object-fit:cover}

.expertise-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}
.expertise-item{padding:20px 18px;border-radius:18px;background:rgba(255,255,255,0.55);border:1px solid rgba(23,23,23,0.06)}
.expertise-index{font-size:12px;letter-spacing:0.12em;color:var(--jj-red);font-weight:600;margin-bottom:10px}
.expertise-item p{margin:0;color:var(--jj-charcoal);font-size:15px;line-height:1.65}

@media (max-width:900px){
  .years-layout{grid-template-columns:1fr;gap:30px}
  .expertise-list{grid-template-columns:1fr}
}

@media (prefers-reduced-motion: reduce){
  .story-image{opacity:1;transform:none;transition:none}
}
</style>

<script>
  const reveals = document.querySelectorAll('.reveal');
  if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.15 });

    reveals.forEach((item) => observer.observe(item));
  } else {
    reveals.forEach((item) => item.classList.add('visible'));
  }
</script>
