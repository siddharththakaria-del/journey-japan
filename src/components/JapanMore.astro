<section class="japan-more" aria-labelledby="jm-heading">
  <div class="jj-container jm-layout">
    <div class="jm-copy">
      <div class="eyebrow eyebrow--accent">THE JOURNEY</div>
      <h2 id="jm-heading" class="jm-title">Japan is more than a destination.</h2>
      <p class="jm-lead">From traditional neighbourhoods and regional food to craftsmanship, landscapes and the contrast between old and new Japan, it is a country best experienced through its details as much as its icons.</p>
      <a class="jm-link" href="/why-japan/">Discover Why Japan <span aria-hidden="true">→</span></a>
    </div>

    <div class="jm-image-wrap">
      <img src="/images/about/journey-japan-heritage.webp" alt="Journey Japan editorial image" />
    </div>
  </div>
</section>

<style>
.japan-more{background:var(--jj-white);padding:clamp(76px,9vw,110px) 0}
.jm-layout{display:grid;grid-template-columns:1fr 1fr;gap:28px;align-items:center}
.jm-copy{max-width:640px}
.eyebrow--accent{font-size:13px;font-weight:600;letter-spacing:0.15em;color:var(--jj-red);margin-bottom:12px}
.jm-title{font-size:clamp(36px,4.5vw,64px);color:var(--jj-charcoal);line-height:1.05;margin:0}
.jm-lead{font-size:17px;color:var(--jj-muted);line-height:1.7;max-width:620px;margin-top:14px}
.jm-link{display:inline-flex;align-items:center;gap:8px;margin-top:24px;color:var(--jj-red);font-weight:600;text-decoration:none}
.jm-link span{color:var(--jj-red)}

.jm-image-wrap{border-radius:22px;overflow:hidden;background:#e8e1d5}
.jm-image-wrap img{display:block;width:100%;height:100%;min-height:420px;object-fit:cover}

@media(max-width:900px){
  .jm-layout{grid-template-columns:1fr}
  .jm-image-wrap img{min-height:300px}
}
</style>
