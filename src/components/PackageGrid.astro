---
import type { Package } from '../data/packages';
const pkgs = Astro.props as { items: Package[] };
---
<section class="section">
  <div class="container">
    <div class="row" style="display:grid;grid-template-columns:repeat(1,1fr);gap:20px">
      {pkgs.items.map(p=> (
        <div class="card" style="display:block">
          <astro-island>
            <a href={`/packages/${p.slug}/`} style="display:block;overflow:hidden">
              <img src={p.image} alt={p.title} style="width:100%;height:300px;object-fit:cover" />
            </a>
            <div class="card__content">
              <h3 class="h3">{p.title}</h3>
              <div class="small" style="color:var(--muted);margin-top:6px">{p.destination} • {p.duration}</div>
              <p class="lead" style="margin-top:8px">{p.short}</p>
              <div style="display:flex;justify-content:space-between;align-items:center;margin-top:12px">
                <div><strong>From</strong> <div>INR {p.priceFromINR.toLocaleString('en-IN')}</div></div>
                <a class="button" href={`/packages/${p.slug}/`}>Explore</a>
              </div>
            </div>
          </astro-island>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
@media(min-width:700px){
  .row{grid-template-columns:repeat(2,1fr)}
}
@media(min-width:1100px){
  .row{grid-template-columns:repeat(3,1fr)}
}
</style>
