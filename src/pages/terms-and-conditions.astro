---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Terms & Conditions | Journey Japan">
  <section class="section" style="padding-top:140px; padding-bottom:120px;">
    <div class="jj-container" style="max-width:800px;">
      <div class="eyebrow" style="color:var(--jj-red); font-size:12px; font-weight:600; letter-spacing:0.15em; margin-bottom:18px;">Terms &amp; Conditions</div>
      <h1 style="font-size:clamp(38px,4vw,56px); line-height:1.05; margin-bottom:18px;">Terms &amp; Conditions</h1>
      <p class="lead" style="max-width:720px; margin-bottom:18px;">This placeholder page will be replaced with the final Journey Japan terms when legal content is approved.</p>
      <p style="color:var(--jj-muted); line-height:1.7;">These placeholder pages keep the footer legal links working while the final legal content is being prepared.</p>
    </div>
  </section>
</Layout>
