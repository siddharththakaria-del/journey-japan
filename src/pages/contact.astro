---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Contact | Journey Japan">
  <section class="section">
    <div class="container">
      <h1 class="h2">Contact</h1>
      <p class="lead">Get in touch to discuss your Japan journey.</p>

      <div style="display:grid;grid-template-columns:1fr;gap:20px;max-width:900px;margin-top:18px">
        <form id="contact-form">
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
            <input name="name" placeholder="Full name" required style="padding:10px" />
            <input name="email" placeholder="Email" type="email" required style="padding:10px" />
            <input name="phone" placeholder="WhatsApp / Phone" style="padding:10px" />
            <input name="country" placeholder="Country" style="padding:10px" />
            <input name="dates" placeholder="Travel dates" style="padding:10px" />
            <input name="travellers" placeholder="Number of travellers" style="padding:10px" />
          </div>
          <div style="margin-top:12px">
            <textarea name="message" placeholder="Tell us about your trip" style="width:100%;min-height:120px;padding:12px"></textarea>
          </div>
          <div style="margin-top:12px;display:flex;gap:12px;justify-content:flex-end">
            <button class="button" type="submit">Send Enquiry</button>
            <a class="button button--ghost" href="https://wa.me/911234567890">WhatsApp</a>
          </div>
        </form>
        <div class="card" style="padding:16px">
          <h3>Office</h3>
          <p class="small">Place holder office address — Tokyo / Remote</p>
          <h4 style="margin-top:12px">Contact</h4>
          <p class="small">Email: info@journey-japan.org</p>
          <p class="small">Phone: +91 12345 67890</p>
        </div>
      </div>
    </div>
  </section>

  <script>
  document.getElementById('contact-form').addEventListener('submit',function(e){
    e.preventDefault();
    alert('Thank you — your enquiry has been received (simulation).');
    this.reset();
  });
  </script>
</Layout>
