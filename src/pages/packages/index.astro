---
import Layout from '../../layouts/Layout.astro';
import { packages } from '../../data/packages';

const filters = [
  { id: 'all', label: 'All' },
  { id: 'fixed', label: 'Fixed Packages' },
  { id: 'group', label: 'Group Tours' },
  { id: 'fit', label: 'FIT' },
  { id: 'custom', label: 'Custom-Made Tours' },
  { id: 'honeymoon', label: 'Honeymoon' },
  { id: 'family', label: 'Family' },
  { id: 'luxury', label: 'Luxury' }
];
---
<Layout title="Japan Packages | Journey Japan">
  <section class="packages-page">
    <div class="container packages-shell">
      <header class="page-hero">
        <p class="eyebrow-gradient">Explore Japan</p>
        <h1>Japan, your way.</h1>
        <p class="hero-copy">Choose a thoughtfully curated journey or create a completely personalized Japan experience.</p>
      </header>

      <div class="filter-panel" aria-label="Package categories">
        <div class="filter-row" role="tablist" aria-label="Package category filter">
          {filters.map((filter) => (
            <button
              type="button"
              class="filter-chip"
              data-filter={filter.id}
              aria-pressed="false"
              role="tab"
            >
              {filter.label}
            </button>
          ))}
        </div>
      </div>

      <div class="fit-callout" aria-live="polite">
        <span class="fit-label">FIT — Flexible Independent Travel</span>
        <p>For travelers who want the freedom of independent travel with thoughtful planning and support.</p>
      </div>

      <aside class="custom-feature">
        <div class="custom-feature__label">PRIVATE & PERSONALIZED</div>
        <h2>Tell us how you want to experience Japan and we'll shape the journey around you.</h2>
        <a href="/customise-your-trip/" class="custom-feature__link">Create My Journey →</a>
      </aside>

      <div id="package-grid" class="package-grid" aria-live="polite">
        {packages.map((pkg) => (
          <article
            class="package-card"
            data-type={pkg.type}
            data-style={pkg.travelStyle}
            data-id={pkg.id}
          >
            <a href={`/packages/${pkg.slug}/`} class="package-card__image-wrap" aria-label={`Explore ${pkg.title}`}>
              <img src={pkg.image} alt={pkg.title} />
            </a>
            <div class="package-card__content">
              <p class="card-tag">{pkg.type}</p>
              <h3>{pkg.title}</h3>
              <div class="card-meta">{pkg.duration} · {pkg.destinations}</div>
              <p class="card-description">{pkg.description}</p>
              <div class="card-footer">
                <div class="card-price">From ₹{pkg.price.toLocaleString('en-IN')}</div>
                <a href={`/packages/${pkg.slug}/`} class="card-link">Explore Journey →</a>
              </div>
            </div>
          </article>
        ))}
      </div>

      <div id="empty-state" class="empty-state" hidden>
        <h3>No journeys found.</h3>
        <p>Try another travel style.</p>
      </div>

      <section class="page-end-cta" aria-label="Custom trip CTA">
        <div>
          <h2>Can't find exactly what you're looking for?</h2>
          <p>Create a Japan journey around your dates, interests and travel style.</p>
        </div>
        <a class="page-end-cta__button" href="/customise-your-trip/">Create My Journey</a>
      </section>
    </div>
  </section>

  <script>
    const filterButtons = Array.from(document.querySelectorAll('.filter-chip'));
    const cards = Array.from(document.querySelectorAll('.package-card'));
    const emptyState = document.getElementById('empty-state');

    function matchesStyle(card, filter) {
      const styleValue = (card.dataset.style || '').toLowerCase();
      const typeValue = (card.dataset.type || '').toLowerCase();
      if (filter === 'all') return true;
      if (filter === typeValue) return true;
      if (styleValue.includes(filter)) return true;
      if (filter === 'fixed' && typeValue === 'fixed') return true;
      return false;
    }

    function applyFilter(nextFilter) {
      let visibleCount = 0;

      filterButtons.forEach((button) => {
        const active = button.dataset.filter === nextFilter;
        button.classList.toggle('is-active', active);
        button.setAttribute('aria-pressed', String(active));
      });

      cards.forEach((card) => {
        const visible = matchesStyle(card, nextFilter);
        card.hidden = !visible;
        if (visible) visibleCount += 1;
      });

      emptyState.hidden = visibleCount !== 0;
    }

    filterButtons.forEach((button) => {
      button.addEventListener('click', () => applyFilter(button.dataset.filter));
    });

    applyFilter('all');
  </script>

  <style>
    .packages-page {
      background: #F8F6F1;
      padding: clamp(72px, 8vw, 120px) 0 clamp(90px, 9vw, 120px);
      overflow-x: clip;
    }

    .packages-shell {
      max-width: 1280px;
    }

    .page-hero {
      margin: 0 auto 24px;
      max-width: 760px;
      text-align: center;
    }

    .eyebrow-gradient {
      margin: 0 0 12px;
      font-size: 12px;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      font-weight: 600;
      background: linear-gradient(90deg, #B3262E, #7F1D2D, #5A1622);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .page-hero h1 {
      margin: 0;
      font-size: clamp(2.4rem, 4vw, 4rem);
      line-height: 1.04;
      letter-spacing: -0.06em;
      color: #171717;
      font-weight: 500;
    }

    .hero-copy {
      margin: 16px auto 0;
      max-width: 680px;
      font-size: 1.06rem;
      line-height: 1.7;
      color: #6F6F6F;
    }

    .filter-panel {
      position: relative;
      margin-top: 30px;
      overflow-x: auto;
      scrollbar-width: none;
      -ms-overflow-style: none;
    }

    .filter-panel::-webkit-scrollbar {
      display: none;
    }

    .filter-row {
      display: flex;
      gap: 10px;
      min-width: max-content;
      padding-bottom: 8px;
      justify-content: center;
      flex-wrap: nowrap;
    }

    .filter-chip {
      appearance: none;
      border: 1px solid rgba(23, 23, 23, 0.12);
      background: transparent;
      color: #171717;
      padding: 10px 14px;
      border-radius: 10px;
      font-size: 0.81rem;
      font-weight: 500;
      cursor: pointer;
      transition: background 220ms ease, color 220ms ease, border-color 220ms ease, transform 220ms ease;
      white-space: nowrap;
    }

    .filter-chip:hover,
    .filter-chip:focus-visible {
      border-color: rgba(179, 38, 46, 0.25);
      color: #171717;
    }

    .filter-chip.is-active {
      background: #171717;
      color: #FFFFFF;
      border-color: #171717;
    }

    .filter-chip.is-active:hover,
    .filter-chip.is-active:focus-visible {
      background: #B3262E;
      border-color: #B3262E;
      color: #FFFFFF;
    }

    .fit-callout {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      margin: 22px auto 0;
      max-width: 760px;
      font-size: 0.82rem;
      line-height: 1.5;
      color: #6F6F6F;
      flex-wrap: wrap;
      text-align: center;
    }

    .fit-label {
      font-weight: 600;
      color: #171717;
      letter-spacing: 0.04em;
    }

    .custom-feature {
      margin: 28px auto 30px;
      display: grid;
      gap: 14px;
      max-width: 980px;
      background: rgba(255, 255, 255, 0.6);
      border: 1px solid rgba(23, 23, 23, 0.08);
      border-radius: 18px;
      padding: 22px 24px;
    }

    .custom-feature__label {
      font-size: 11px;
      letter-spacing: 0.14em;
      color: #B3262E;
      font-weight: 600;
    }

    .custom-feature h2 {
      margin: 0;
      font-size: clamp(1.35rem, 2.2vw, 2.2rem);
      line-height: 1.2;
      letter-spacing: -0.05em;
      color: #171717;
      font-weight: 500;
    }

    .custom-feature__link {
      color: #B3262E;
      font-weight: 600;
      text-decoration: none;
      transition: color 220ms ease, transform 220ms ease;
    }

    .custom-feature__link:hover,
    .custom-feature__link:focus-visible {
      color: #7F1D2D;
      transform: translateX(2px);
    }

    .package-grid {
      display: grid;
      grid-template-columns: repeat(1, minmax(0, 1fr));
      gap: 28px;
      margin-top: 24px;
    }

    .package-card {
      background: rgba(255, 255, 255, 0.7);
      border: 1px solid rgba(23, 23, 23, 0.08);
      border-radius: 20px;
      overflow: hidden;
      transition: transform 220ms ease, box-shadow 220ms ease, border-color 220ms ease;
    }

    .package-card:hover,
    .package-card:focus-within {
      transform: translateY(-2px);
      box-shadow: 0 18px 36px rgba(23, 23, 23, 0.06);
      border-color: rgba(179, 38, 46, 0.18);
    }

    .package-card__image-wrap {
      display: block;
      overflow: hidden;
    }

    .package-card__image-wrap img {
      display: block;
      width: 100%;
      aspect-ratio: 4 / 3;
      object-fit: cover;
      border-radius: 0;
      transition: transform 600ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    .package-card:hover .package-card__image-wrap img,
    .package-card:focus-within .package-card__image-wrap img {
      transform: scale(1.04);
    }

    .package-card__content {
      padding: 22px 22px 18px;
    }

    .card-tag {
      margin: 0;
      font-size: 11px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: #B3262E;
      font-weight: 600;
    }

    .package-card__content h3 {
      margin: 10px 0 0;
      font-size: clamp(1.5rem, 2vw, 1.7rem);
      line-height: 1.2;
      letter-spacing: -0.04em;
      color: #171717;
      font-weight: 500;
    }

    .card-meta {
      margin-top: 10px;
      font-size: 13px;
      color: #6F6F6F;
    }

    .card-description {
      margin-top: 12px;
      font-size: 15px;
      color: #6F6F6F;
      line-height: 1.6;
    }

    .card-footer {
      margin-top: 18px;
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 16px;
    }

    .card-price {
      font-size: clamp(1.05rem, 1.7vw, 1.2rem);
      color: #171717;
      font-weight: 600;
    }

    .card-link {
      color: #B3262E;
      text-decoration: none;
      font-weight: 600;
      transition: color 220ms ease, transform 220ms ease;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    .card-link:hover,
    .card-link:focus-visible {
      color: #7F1D2D;
    }

    .card-link:hover::after,
    .card-link:focus-visible::after {
      transform: translateX(3px);
    }

    .card-link::after {
      content: '→';
      display: inline-block;
      transition: transform 220ms ease;
    }

    .empty-state {
      margin-top: 30px;
      padding: 32px 20px;
      border-radius: 18px;
      border: 1px solid rgba(23, 23, 23, 0.08);
      background: rgba(255, 255, 255, 0.7);
      text-align: center;
    }

    .empty-state h3 {
      margin: 0;
      font-size: clamp(1.5rem, 2vw, 1.8rem);
      color: #171717;
    }

    .empty-state p {
      margin: 8px 0 0;
      color: #6F6F6F;
    }

    .page-end-cta {
      margin-top: 42px;
      background: #171717;
      border-radius: 20px;
      padding: clamp(24px, 4vw, 34px);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      flex-wrap: wrap;
    }

    .page-end-cta h2 {
      margin: 0;
      color: #FFFFFF;
      font-size: clamp(1.7rem, 2vw, 2.3rem);
      line-height: 1.15;
      letter-spacing: -0.04em;
      font-weight: 500;
    }

    .page-end-cta p {
      margin: 10px 0 0;
      color: rgba(255,255,255,0.76);
      font-size: 1rem;
      line-height: 1.6;
    }

    .page-end-cta__button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 46px;
      padding: 0 22px;
      border-radius: 12px;
      background: #FFFFFF;
      color: #171717;
      text-decoration: none;
      font-weight: 600;
      transition: background 220ms ease, color 220ms ease, transform 220ms ease;
    }

    .page-end-cta__button:hover,
    .page-end-cta__button:focus-visible {
      background: #B3262E;
      color: #FFFFFF;
      transform: translateY(-2px);
    }

    @media (min-width: 768px) {
      .package-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (min-width: 1200px) {
      .package-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
    }

    @media (max-width: 767px) {
      .packages-page {
        padding-top: 48px;
      }

      .page-hero h1 {
        font-size: clamp(2.4rem, 9vw, 2.8rem);
      }

      .hero-copy {
        font-size: 1rem;
      }

      .filter-row {
        justify-content: flex-start;
      }

      .custom-feature {
        padding: 18px 18px 20px;
      }

      .page-end-cta {
        align-items: flex-start;
      }
    }
  </style>
</Layout>
