---
import Layout from '../layouts/Layout.astro';

const heroImage = '/journey-japan/images/hero/japan-hero.webp';

const japanCards = [
  {
    eyebrow: 'CULTURE',
    heading: 'Culture that lives in everyday life',
    copy:
      "Japan's culture is not confined to museums or historic monuments. It can be found in the way a garden is designed, the rituals surrounding tea, the quiet atmosphere of a shrine, a local festival or the craftsmanship behind an everyday object."
  },
  {
    eyebrow: 'SEASONS',
    heading: 'A different Japan in every season',
    copy:
      'Japan changes dramatically throughout the year. Spring brings cherry blossoms and fresh greenery, summer brings festivals and fireworks, autumn transforms landscapes with vivid foliage, while winter offers snow, hot springs and a quieter atmosphere.'
  },
  {
    eyebrow: 'FOOD',
    heading: 'Food shaped by place and season',
    copy:
      "Japanese cuisine goes far beyond sushi. Regional specialties, seasonal ingredients, traditional dining, local markets and carefully prepared dishes reveal something about the place where they are enjoyed. For our travellers, experiencing Japan also means being able to enjoy it comfortably. Through our established restaurant relationships, we help arrange vegetarian and Jain-friendly dining throughout the journey with careful attention to dietary requirements."
  },
  {
    eyebrow: 'NATURE & CITIES',
    heading: 'From neon streets to quiet landscapes',
    copy:
      "Tokyo can feel almost impossibly futuristic, while a short journey can take travellers toward mountain towns, gardens, forests, coastlines and traditional communities. Japan's geography allows travellers to combine urban energy with nature and slower regional experiences."
  }
];

const experiences = [
  {
    number: '01',
    title: 'Tradition & heritage',
    copy:
      "Temples, shrines, historic streets, gardens, traditional arts and places where Japan's cultural heritage remains part of everyday life."
  },
  {
    number: '02',
    title: 'Modern Japan',
    copy:
      "Tokyo's architecture, technology, fashion, entertainment, design and neighbourhoods reveal the country's contemporary character."
  },
  {
    number: '03',
    title: 'Nature & escape',
    copy:
      'Mountain landscapes, gardens, countryside, coastal scenery and slower journeys away from the busiest urban centres.'
  },
  {
    number: '04',
    title: 'Japanese food',
    copy:
      'Regional cuisine, seasonal dining, traditional dishes and carefully selected restaurants, including vegetarian and Jain-friendly arrangements where required.'
  },
  {
    number: '05',
    title: 'Hands-on experiences',
    copy:
      'Cooking, crafts, cultural workshops, local encounters and experiences that allow travellers to participate rather than simply observe.'
  },
  {
    number: '06',
    title: 'Quiet Japan',
    copy:
      'Ryokan stays, hot springs, peaceful gardens, smaller towns and moments where the pace of travel naturally slows down.'
  }
];

const planningCards = [
  {
    number: '01',
    title: '30+ years of Japan',
    copy:
      'Our relationship with Japan spans more than three decades. That experience gives us a deeper understanding of the country, its destinations and the practical details that turn a complicated itinerary into a smoother journey.'
  },
  {
    number: '02',
    title: 'Authentic local connections',
    copy:
      'We believe the most memorable Japan experiences often happen away from a standard sightseeing checklist. Our local relationships help us connect travellers with experiences that feel more personal, considered and genuinely connected to Japan.'
  },
  {
    number: '03',
    title: 'Vegetarian & Jain-friendly travel',
    copy:
      "Food should never become a compromise during your journey. Through our strong relationships within Japan's restaurant community, we can plan vegetarian and Jain-friendly dining arrangements throughout the trip with careful attention to dietary requirements."
  },
  {
    number: '04',
    title: 'Your journey, your way',
    copy:
      'Choose a carefully designed package or start from a blank page. Whether you are travelling as a couple, family, group, independently or privately, we can shape the journey around your interests, pace and priorities.'
  }
];

const travelPaths = [
  {
    title: 'Classic Japan',
    subtitle: 'For first-time travellers',
    copy: 'Iconic cities, essential experiences and a balanced introduction to Japan.',
    href: '/journey-japan/packages/',
    cta: 'Explore Packages'
  },
  {
    title: 'Private Japan',
    subtitle: 'For travellers who want it their way',
    copy: 'Personalized itineraries, private experiences and a journey built around your priorities.',
    href: '/customise-your-trip/',
    cta: 'Create a Private Journey'
  },
  {
    title: 'Japan for couples',
    subtitle: 'For two',
    copy: 'Romantic stays, memorable experiences and a pace designed around the two of you.',
    href: '/journey-japan/packages/japan-honeymoon/',
    cta: 'Explore Honeymoon Tours'
  },
  {
    title: 'Japan for families',
    subtitle: 'For every generation',
    copy: 'Comfortable pacing, engaging experiences and thoughtful planning for families travelling together.',
    href: '/journey-japan/packages/family-japan-adventure/',
    cta: 'Explore Family Tours'
  },
  {
    title: 'Japan by season',
    subtitle: 'Choose your moment',
    copy: 'Cherry blossoms, summer festivals, autumn colours or winter landscapes — every season tells a different story.',
    href: '/journey-japan/travel-guide/best-time-to-visit-japan/',
    cta: 'Discover the Seasons'
  }
];
---

<Layout
  title="Why Japan?"
  description="Discover why Japan is one of the world's most rewarding destinations, from culture and seasonal beauty to food, nature and authentic local experiences with Journey Japan."
  canonical="/why-japan/"
  image={heroImage}
>
  <div class="why-japan-page">
    <section class="hero">
      <div class="hero__media" aria-hidden="true">
        <img src={heroImage} alt="" />
        <div class="hero__overlay"></div>
      </div>

      <div class="container hero__content">
        <p class="eyebrow">WHY JAPAN</p>
        <h1>Japan is more than a destination.</h1>
        <p class="hero__lead">
          It is a country of contrasts, where centuries-old traditions, extraordinary food, thoughtful hospitality and futuristic cities exist side by side. The real beauty of Japan lies in how naturally these worlds come together — and how much there is to discover beyond the familiar.
        </p>
        <div class="hero__actions">
          <a class="button button--light" href="/journey-japan/packages/">Explore Japan</a>
          <a class="button button--outline" href="/journey-japan/customise-your-trip/">Plan My Journey</a>
        </div>
      </div>
    </section>

    <section class="content-section">
      <div class="container">
        <p class="section-kicker">THE JAPAN EXPERIENCE</p>
        <div class="section-heading">
          <h2>Some countries are visited. Japan is experienced.</h2>
          <p>
            Japan has an unusual ability to make very different experiences feel connected. A morning can begin in the quiet of a traditional temple, continue through the energy of a modern city and end with an intimate meal shaped by the season. The journey is not simply about seeing famous places; it is about noticing the details that make each place feel distinctly Japanese.
          </p>
        </div>

        <div class="card-grid card-grid--four">
          {japanCards.map((card) => (
            <article class="info-card">
              <p class="card-eyebrow">{card.eyebrow}</p>
              <h3>{card.heading}</h3>
              <p>{card.copy}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="content-section content-section--alt">
      <div class="container">
        <p class="section-kicker">BEYOND THE CLASSICS</p>
        <div class="section-heading">
          <h2>There is no single way to experience Japan.</h2>
          <p>
            Japan can be energetic, peaceful, adventurous, romantic, deeply traditional or completely contemporary. The right journey depends on what you want to feel, discover and remember. That is why Japan should never be reduced to a checklist of attractions.
          </p>
        </div>

        <div class="card-grid card-grid--six">
          {experiences.map((item) => (
            <article class="experience-card">
              <span class="experience-card__number">{item.number}</span>
              <h3>{item.title}</h3>
              <p>{item.copy}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="content-section">
      <div class="container">
        <p class="section-kicker">WHY JOURNEY JAPAN</p>
        <div class="section-heading">
          <h2>The difference is not just where you go. It's how the journey is planned.</h2>
          <p>
            Japan rewards thoughtful planning. The best experience is rarely created by simply adding more places to an itinerary. It comes from understanding how destinations connect, when to visit them, how much time to allow, where local experiences fit naturally and which details will make the journey more comfortable.
          </p>
        </div>

        <div class="feature-list">
          {planningCards.map((card, index) => (
            <article class={`feature-row ${index === 2 ? 'feature-row--accent' : ''}`}>
              <div class="feature-row__index">{card.number}</div>
              <div class="feature-row__content">
                <h3>{card.title}</h3>
                <p>{card.copy}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="content-section content-section--alt">
      <div class="container">
        <p class="section-kicker">YOUR JAPAN</p>
        <div class="section-heading">
          <h2>What kind of Japan would you like to discover?</h2>
          <p>
            There is no perfect itinerary for everyone. Start with the kind of journey you want, and we will help you find the places, experiences and pace that fit.
          </p>
        </div>

        <div class="path-grid">
          {travelPaths.map((path) => (
            <a class="path-card" href={path.href}>
              <p class="path-card__eyebrow">{path.subtitle}</p>
              <h3>{path.title}</h3>
              <p>{path.copy}</p>
              <span class="path-card__cta">{path.cta} →</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="final-cta-section">
      <div class="container">
        <div class="final-cta-card">
          <div>
            <p class="final-cta-card__eyebrow">READY TO DISCOVER JAPAN?</p>
            <h2>Tell us what Japan means to you.</h2>
            <p>
              Whether you already know where you want to go or are still imagining your first journey, we can help turn your ideas into a thoughtful Japan itinerary. Tell us what interests you, how you like to travel and what matters most — we'll take it from there.
            </p>
          </div>
          <div class="final-cta-card__actions">
            <a class="button button--light" href="/journey-japan/customise-your-trip/">Plan My Journey</a>
            <a class="button button--outline button--outline-light" href="/journey-japan/packages/">Explore Packages</a>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .why-japan-page {
    padding-top: 22px;
    overflow-x: clip;
    background: #f8f6f1;
    color: #242424;
  }

  .hero {
    position: relative;
    min-height: clamp(68vh, 76vh, 860px);
    display: flex;
    align-items: end;
    overflow: hidden;
  }

  .hero__media {
    position: absolute;
    inset: 0;
  }

  .hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(11, 11, 11, 0.84) 0%, rgba(11, 11, 11, 0.58) 45%, rgba(11, 11, 11, 0.18) 100%);
  }

  .hero__content {
    position: relative;
    z-index: 1;
    padding-block: clamp(56px, 8vw, 96px);
    color: #fff;
    max-width: 760px;
  }

  .eyebrow,
  .section-kicker,
  .card-eyebrow,
  .final-cta-card__eyebrow {
    margin: 0 0 14px;
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 600;
    color: #f3dde1;
  }

  .hero h1 {
    margin: 0;
    font-size: clamp(42px, 5vw, 72px);
    line-height: 1.02;
    letter-spacing: -0.05em;
    font-weight: 500;
    color: #fff;
    max-width: 720px;
  }

  .hero__lead {
    margin: 18px 0 0;
    max-width: 680px;
    font-size: clamp(17px, 1.5vw, 19px);
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.88);
  }

  .hero__actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 30px;
  }

  .button {
    min-height: 52px;
    padding: 0 24px;
    border-radius: 12px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    font-weight: 600;
    transition: transform 280ms ease, background 280ms ease, border-color 280ms ease, color 280ms ease;
  }

  .button:hover,
  .button:focus-visible {
    transform: translateY(-2px);
  }

  .button--light {
    background: #fff;
    color: #171717;
  }

  .button--light:hover,
  .button--light:focus-visible {
    background: #b3262e;
    color: #fff;
  }

  .button--outline {
    background: transparent;
    border: 1px solid rgba(23, 23, 23, 0.16);
    color: #171717;
  }

  .button--outline-light {
    border-color: rgba(255, 255, 255, 0.4);
    color: #fff;
  }

  .button--outline-light:hover,
  .button--outline-light:focus-visible {
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
  }

  .content-section {
    padding: clamp(84px, 10vw, 140px) 0;
    background: #fff;
  }

  .content-section--alt {
    background: #f8f6f1;
  }

  .section-heading {
    max-width: 820px;
    margin-bottom: 42px;
  }

  .section-heading h2 {
    margin: 0;
    color: #171717;
    font-size: clamp(34px, 4.4vw, 56px);
    line-height: 1.06;
    letter-spacing: -0.05em;
    font-weight: 500;
  }

  .section-heading p {
    margin: 18px 0 0;
    max-width: 760px;
    font-size: clamp(16px, 1.45vw, 18px);
    line-height: 1.7;
    color: #6f6f6f;
  }

  .card-grid {
    display: grid;
    gap: 20px;
  }

  .card-grid--four {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .card-grid--six {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .info-card,
  .experience-card,
  .path-card {
    background: #fff;
    border: 1px solid rgba(0, 0, 0, 0.06);
    border-radius: 22px;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.06);
    transition: transform 320ms ease, box-shadow 320ms ease;
  }

  .info-card:hover,
  .experience-card:hover,
  .path-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.09);
  }

  .info-card {
    padding: clamp(28px, 3.2vw, 42px);
  }

  .info-card h3,
  .experience-card h3,
  .path-card h3,
  .feature-row h3 {
    margin: 0;
    color: #171717;
    font-size: clamp(22px, 2vw, 30px);
    line-height: 1.08;
    font-weight: 500;
  }

  .info-card p,
  .experience-card p,
  .path-card p,
  .feature-row p {
    margin: 14px 0 0;
    color: #6f6f6f;
    font-size: 16px;
    line-height: 1.72;
  }

  .experience-card {
    padding: 28px;
    min-height: 220px;
  }

  .experience-card__number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 42px;
    height: 42px;
    border-radius: 999px;
    margin-bottom: 16px;
    background: rgba(179, 38, 46, 0.08);
    color: #b3262e;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
  }

  .feature-list {
    display: grid;
    gap: 16px;
  }

  .feature-row {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr);
    gap: 22px;
    align-items: start;
    padding: 32px 0;
    border-top: 1px solid rgba(23, 23, 23, 0.08);
  }

  .feature-row:last-child {
    border-bottom: 1px solid rgba(23, 23, 23, 0.08);
  }

  .feature-row__index {
    color: #b3262e;
    font-size: 13px;
    letter-spacing: 0.16em;
    font-weight: 700;
    padding-top: 8px;
  }

  .feature-row--accent {
    position: relative;
  }

  .feature-row--accent .feature-row__index {
    color: #8f1f26;
  }

  .feature-row--accent::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    width: 72px;
    height: 2px;
    background: linear-gradient(90deg, #b3262e, #b89a5a);
  }

  .path-grid {
    display: grid;
    gap: 20px;
    grid-template-columns: repeat(12, minmax(0, 1fr));
  }

  .path-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 28px;
    color: inherit;
    text-decoration: none;
    min-height: 220px;
  }

  .path-card:nth-child(1),
  .path-card:nth-child(2),
  .path-card:nth-child(3) {
    grid-column: span 4;
  }

  .path-card:nth-child(4),
  .path-card:nth-child(5) {
    grid-column: span 6;
  }

  .path-card__eyebrow {
    margin: 0 0 12px;
    color: #b3262e;
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 700;
  }

  .path-card__cta {
    display: inline-flex;
    margin-top: 24px;
    color: #b3262e;
    font-weight: 600;
    transition: color 220ms ease, transform 220ms ease;
  }

  .path-card:hover .path-card__cta,
  .path-card:focus-visible .path-card__cta {
    color: #8f1f26;
    transform: translateX(3px);
  }

  .final-cta-section {
    padding: clamp(86px, 11vw, 150px) 0;
    background: #f8f6f1;
  }

  .final-cta-card {
    max-width: 1160px;
    margin: 0 auto;
    padding: clamp(40px, 5vw, 84px);
    border-radius: 24px;
    background: #171717;
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.12);
    display: flex;
    gap: 28px;
    justify-content: space-between;
    align-items: center;
  }

  .final-cta-card__eyebrow {
    color: #f3dde1;
  }

  .final-cta-card h2 {
    margin: 0;
    color: #fff;
    font-size: clamp(34px, 4vw, 54px);
    line-height: 1.05;
    letter-spacing: -0.05em;
    font-weight: 500;
    max-width: 620px;
  }

  .final-cta-card p {
    margin: 18px 0 0;
    max-width: 640px;
    color: rgba(255, 255, 255, 0.78);
    font-size: 16px;
    line-height: 1.72;
  }

  .final-cta-card__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: flex-end;
  }

  @media (max-width: 1023px) {
    .card-grid--six {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .path-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .path-card:nth-child(1),
    .path-card:nth-child(2),
    .path-card:nth-child(3),
    .path-card:nth-child(4),
    .path-card:nth-child(5) {
      grid-column: auto;
    }
  }

  @media (max-width: 767px) {
    .why-japan-page {
      padding-top: 22px;
    }

    .hero {
      min-height: 66vh;
    }

    .card-grid--four,
    .card-grid--six,
    .path-grid {
      grid-template-columns: 1fr;
    }

    .feature-row {
      grid-template-columns: 1fr;
      gap: 10px;
      padding: 24px 0;
    }

    .final-cta-card {
      flex-direction: column;
      align-items: flex-start;
      padding: 40px 24px;
    }

    .button {
      width: 100%;
    }

    .final-cta-card__actions {
      width: 100%;
      justify-content: flex-start;
    }
  }
</style>

